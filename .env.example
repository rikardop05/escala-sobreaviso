# Clerk — copie do dashboard em clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx

# Redis (Vercel KV) — injetada automaticamente na Vercel.
# Só é necessária LOCALMENTE para rodar os scripts de manutenção
# (scripts/migrate-team-keys.mjs, scripts/restore-backup.mjs).
# Onde achar: painel da Vercel → o projeto → Storage → o banco Redis → aba .env.local,
# ou Settings → Environment Variables → REDIS_URL.
REDIS_URL=redis://default:xxxxx@xxxxx.upstash.io:6379

# Backup cifrado — só necessária para rodar scripts/restore-backup.mjs localmente.
# 32 bytes em hex; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=xxxxx
